# Copie para .env e ajuste. O .env nunca vai para o Git.

# Onde a Mente escuta (o mod conecta aqui; ver mod: config/waifuscam.json)
WAIFU_HOST=127.0.0.1
WAIFU_PORT=8765

# Personagem: pasta em characters/ ou characters/private/
WAIFU_CHARACTER=lumi

# DEBUG mostra cada mensagem do protocolo
WAIFU_LOG_LEVEL=INFO

# Skin a partir de PNG (character.toml → [skin] file = "skin.png").
# Grátis em https://account.mineskin.org/keys. Não precisa para [skin] username.
MINESKIN_API_KEY=

# Chaves de IA (usadas a partir da fase 2)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
