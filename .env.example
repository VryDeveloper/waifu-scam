# Copie para .env e ajuste. O .env nunca vai para o Git.

# Onde a Mente escuta (o mod conecta aqui; ver mod: config/waifuscam.json)
WAIFU_HOST=127.0.0.1
WAIFU_PORT=8765

# Personagem: pasta em characters/ ou characters/private/
WAIFU_CHARACTER=lumi

# DEBUG mostra cada mensagem do protocolo
WAIFU_LOG_LEVEL=INFO

# Skin a partir de PNG (character.toml → [skin] file = "skin.png").
# Grátis em https://account.mineskin.org/keys. Não precisa para [skin] username.
MINESKIN_API_KEY=

# Chaves de IA: preencha pelo menos uma. Sem nenhuma, ela só responde em eco.
# A ordem de tentativa fica em characters/<id>/character.toml → [llm] provider_order.
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/keys  (modelos terminados em :free)
OPENROUTER_API_KEY=
# Opcional: trocar o modelo de um provedor
# GROQ_MODEL=openai/gpt-oss-120b
# Ollama ou outro servidor local: inclua "custom" no provider_order
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_MODEL=llama3.2
