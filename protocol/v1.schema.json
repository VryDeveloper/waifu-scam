{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VryDeveloper/waifu-scam/protocol/v1.schema.json",
  "title": "Waifu Scam — protocolo Corpo ↔ Mente v1",
  "description": "Mensagens trocadas por WebSocket (texto JSON). Campos desconhecidos devem ser ignorados por quem recebe.",
  "type": "object",
  "required": [
    "v",
    "type"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "bot": {
      "type": [
        "string",
        "null"
      ],
      "description": "Id da personagem. null antes do welcome."
    },
    "type": {
      "type": "string"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/welcome"
    },
    {
      "$ref": "#/$defs/ping"
    },
    {
      "$ref": "#/$defs/pong"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/chat.say"
    },
    {
      "$ref": "#/$defs/skill.start"
    },
    {
      "$ref": "#/$defs/skill.cancel"
    },
    {
      "$ref": "#/$defs/skill.done"
    },
    {
      "$ref": "#/$defs/skill.failed"
    }
  ],
  "$defs": {
    "hello": {
      "description": "Corpo → Mente, primeira mensagem ao conectar.",
      "properties": {
        "type": {
          "const": "hello"
        },
        "protocol": {
          "const": 1
        },
        "body": {
          "type": "string",
          "examples": [
            "fabric",
            "sim"
          ]
        },
        "body_version": {
          "type": "string"
        },
        "minecraft": {
          "type": [
            "string",
            "null"
          ],
          "examples": [
            "26.3"
          ]
        },
        "skills": {
          "type": "array",
          "description": "Catálogo de habilidades que o corpo executa (fase 3). A Mente só pede o que estiver aqui.",
          "items": {
            "$ref": "#/$defs/skillSpec"
          }
        }
      },
      "required": [
        "type",
        "protocol",
        "body",
        "body_version"
      ]
    },
    "welcome": {
      "description": "Mente → Corpo, resposta ao hello. Define o id (bot) usado daqui em diante.",
      "properties": {
        "type": {
          "const": "welcome"
        },
        "bot": {
          "type": "string"
        },
        "character": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "language": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "language"
          ]
        },
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{3,16}$",
          "description": "Nome de player no Minecraft."
        },
        "skin": {
          "type": [
            "object",
            "null"
          ],
          "description": "Textura assinada pela Mojang (propriedade 'textures' do GameProfile). null = skin padrão.",
          "properties": {
            "value": {
              "type": "string"
            },
            "signature": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "signature"
          ]
        }
      },
      "required": [
        "type",
        "bot",
        "character",
        "username"
      ]
    },
    "ping": {
      "description": "Qualquer lado. Quem recebe responde pong com o mesmo id.",
      "properties": {
        "type": {
          "const": "ping"
        },
        "id": {
          "type": "string"
        },
        "t": {
          "type": "integer",
          "description": "Hora do envio em ms (epoch), opcional."
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "pong": {
      "properties": {
        "type": {
          "const": "pong"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "event": {
      "description": "Corpo → Mente. Algo aconteceu no jogo. chat traz 'from' e 'text'; died e despawned trazem 'message'; danger traz o tipo do bicho em 'message' (fase 5); remember_place traz name, x, y, z, dimension e from (fase 6).",
      "properties": {
        "type": {
          "const": "event"
        },
        "event": {
          "type": "string",
          "examples": [
            "chat",
            "spawned",
            "despawned",
            "died",
            "respawned",
            "danger",
            "remember_place"
          ]
        }
      },
      "required": [
        "type",
        "event"
      ]
    },
    "error": {
      "description": "Qualquer lado. A mensagem anterior foi recusada.",
      "properties": {
        "type": {
          "const": "error"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ]
    },
    "state": {
      "description": "Corpo → Mente, a cada ~2 s. Snapshot da personagem.",
      "properties": {
        "type": {
          "const": "state"
        },
        "online": {
          "type": "boolean"
        },
        "alive": {
          "type": "boolean"
        },
        "health": {
          "type": "number"
        },
        "max_health": {
          "type": "number"
        },
        "food": {
          "type": "integer"
        },
        "saturation": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "dimension": {
          "type": "string",
          "examples": [
            "minecraft:overworld"
          ]
        },
        "players": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Players online, incluindo a personagem."
        },
        "time_of_day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23999,
          "description": "Hora do jogo em ticks (0 = amanhecer, 6000 = meio-dia, 13000 = noite)."
        },
        "weather": {
          "enum": [
            "clear",
            "rain",
            "thunder"
          ]
        },
        "skill": {
          "type": [
            "object",
            "null"
          ],
          "description": "Habilidade rodando agora (fase 3).",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "doing": {
              "type": "string",
              "examples": [
                "seguindo Vry"
              ]
            }
          }
        },
        "inventory": {
          "type": "object",
          "description": "Fase 4: até 20 itens que ela mais tem, {\"oak_log\": 12}.",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "holding": {
          "type": [
            "string",
            "null"
          ],
          "description": "Fase 4: item na mão."
        },
        "threats": {
          "type": "array",
          "description": "Fase 5: monstros por perto.",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "distance": {
                "type": "number"
              }
            }
          }
        },
        "sky": {
          "type": "boolean",
          "description": "Fase 5: ao ar livre."
        },
        "light": {
          "type": "integer"
        },
        "in_water": {
          "type": "boolean"
        },
        "on_fire": {
          "type": "boolean"
        },
        "air": {
          "type": "integer"
        },
        "reflex": {
          "type": "string",
          "description": "Fase 5: o que o reflexo está fazendo agora (ex.: comendo)."
        }
      },
      "required": [
        "type",
        "online"
      ]
    },
    "chat.say": {
      "description": "Mente → Corpo. A personagem fala no chat do jogo.",
      "properties": {
        "type": {
          "const": "chat.say"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    "skillSpec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "examples": [
            "follow",
            "goto",
            "stop"
          ]
        },
        "description": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "description": "JSON Schema dos argumentos."
        }
      },
      "required": [
        "name"
      ]
    },
    "skill.start": {
      "description": "Mente → Corpo. Começa uma habilidade do catálogo; a que estava rodando é interrompida. 'stop' para tudo.",
      "properties": {
        "type": {
          "const": "skill.start"
        },
        "id": {
          "type": "string",
          "description": "Escolhido por quem pede; volta em skill.done/skill.failed."
        },
        "skill": {
          "type": "string"
        },
        "args": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "id",
        "skill"
      ]
    },
    "skill.cancel": {
      "description": "Mente → Corpo. Para a habilidade atual.",
      "properties": {
        "type": {
          "const": "skill.cancel"
        }
      },
      "required": [
        "type"
      ]
    },
    "skill.done": {
      "description": "Corpo → Mente. A habilidade terminou bem.",
      "properties": {
        "type": {
          "const": "skill.done"
        },
        "id": {
          "type": "string"
        },
        "skill": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "skill"
      ]
    },
    "skill.failed": {
      "description": "Corpo → Mente. A habilidade não terminou.",
      "properties": {
        "type": {
          "const": "skill.failed"
        },
        "id": {
          "type": "string"
        },
        "skill": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "description": "Motivo em português."
        },
        "cancelled": {
          "type": "boolean",
          "description": "true = não foi falha: trocada por outra, mandaram parar, ela morreu ou saiu."
        }
      },
      "required": [
        "type",
        "id",
        "skill",
        "reason"
      ]
    }
  }
}
